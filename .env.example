# Webhook 服务端口
PORT=28080

# Gitea Webhook 密钥
# 生成方法: openssl rand -hex 32
# 所有仓库共用此密钥；如需每个仓库独立密钥，可在 REPOS_JSON 的每项中加 "secret" 字段
WEBHOOK_SECRET=your-webhook-secret-here

# ==================== 多仓库配置（推荐） ====================
# REPOS_JSON 是一个 JSON 数组，每项必须包含 full_name / path / branch
# 不同仓库的 push 会根据 repository.full_name 匹配到对应的 path 进行构建
# 注意：.env 里的多行值必须用单引号或双引号包裹
# 示例：
# REPOS_JSON='[
#   { "full_name": "username/blog-a", "path": "/var/www/blog-a", "branch": "main" },
#   { "full_name": "username/blog-b", "path": "/var/www/blog-b", "branch": "main" }
# ]'

# ==================== 单仓库配置（兼容旧版） ====================
# 如果不配置 REPOS_JSON，则使用下面的 BLOG_PATH + GIT_BRANCH

# 博客项目路径
BLOG_PATH=/home/wwwroot/blog

# Git 仓库地址（SSH 格式，仅做记录，脚本中未使用）
# 示例: ssh://git@git.example.com:222/username/blog.git
GIT_REPO=ssh://git@git.example.com:222/username/blog.git

# 监听的 Git 分支
GIT_BRANCH=main

# 日志级别：info | error
LOG_LEVEL=info
